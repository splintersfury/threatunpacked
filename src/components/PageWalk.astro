<section class="lab-band" aria-label="Live address translation">
  <canvas id="pw-canvas" aria-hidden="true"></canvas>
  <div class="mmu-ui" aria-live="off">
    <p class="mmu-cap">mmu &middot; live translation</p>
    <p class="mmu-line"><span class="mmu-k">va&nbsp;&nbsp;</span><span class="mmu-va" id="pw-va">resolving&hellip;</span></p>
    <p class="mmu-line"><span class="mmu-k">walk</span> <span id="pw-path" class="mmu-path">cr3 &rarr;</span></p>
  </div>
</section>

<style>
  .lab-band {
    position: relative;
    height: clamp(250px, 34vh, 350px);
    overflow: hidden;
    background: #0b0e14;
    border-bottom: 1px solid #1c2536;
  }
  #pw-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
  }
  .mmu-ui {
    position: absolute;
    top: 1.1rem;
    left: 1.25rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--ink-soft);
    pointer-events: none;
  }
  .mmu-cap {
    margin: 0 0 0.35rem;
    color: var(--muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.68rem;
  }
  .mmu-line { margin: 0; white-space: nowrap; }
  .mmu-k { color: var(--muted); }
  .mmu-va { color: var(--num, #e0af68); }
  .mmu-path { color: var(--accent, #7dcfff); }
  .mmu-path .miss { color: var(--crit, #f7768e); }
  .mmu-path .phys { color: var(--accent2, #9ece6a); }
</style>

<script>
  // The machine under the page. Every symbol in the listing resolves
  // through the same four-level x64 page walk this band runs on loop:
  // cr3 -> PML4 -> PDPT -> PD -> PT -> 4 KiB page, and every so often a
  // not-present entry raises #PF. The indices are real: each hop is
  // (va >> shift) & 0x1FF of the address shown in the readout.
  const boot = async () => {
    const canvas = document.getElementById('pw-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const THREE = await import('three');
    let renderer: import('three').WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: 'low-power' });
    } catch {
      return;
    }
    renderer.setClearColor(0x0b0e14, 1);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 200);

    const SKY = 0x7dcfff, GREEN = 0x9ece6a, AMBER = 0xe0af68, CRIT = 0xf7768e;
    const SLAB = 0x0f1420, CELL = 0x18233a, EDGE = 0x22304a;

    const hex = (v: number) => '0x' + v.toString(16).toUpperCase().padStart(12, '0');
    const idxOf = (va: number, shift: number) => Math.floor(va / Math.pow(2, shift)) & 511;

    const WALKS: { va: number; miss?: number }[] = [
      { va: 0x00007ff61e4b9c40 },
      { va: 0xfffff8033a01b4a0 },
      { va: 0x0000018f7b2e1000 },
      { va: 0xffff9004c3187000, miss: 2 }, // pd entry absent -> #PF
    ];
    const LEVELS = [
      { y: 3.6, name: 'pml4', shift: 39 },
      { y: 1.2, name: 'pdpt', shift: 30 },
      { y: -1.2, name: 'pd', shift: 21 },
      { y: -3.6, name: 'pte', shift: 12 },
    ];
    const PHYS_Y = -6.7;

    const cellXZ = (idx: number): [number, number] => {
      const c = idx % 32, r = Math.floor(idx / 32);
      return [(c - 15.5) * 0.34, (r - 7.5) * 0.34];
    };

    // ── level tables ─────────────────────────────────────────────
    const slabGeo = new THREE.BoxGeometry(12.2, 0.16, 6.4);
    const cellGeo = new THREE.BoxGeometry(0.26, 0.05, 0.26);
    const levelObjs = LEVELS.map((L) => {
      const g = new THREE.Group();
      g.position.y = L.y;
      const slab = new THREE.Mesh(slabGeo, new THREE.MeshBasicMaterial({ color: SLAB }));
      const edges = new THREE.LineSegments(
        new THREE.EdgesGeometry(slabGeo),
        new THREE.LineBasicMaterial({ color: EDGE })
      );
      g.add(slab, edges);
      const inst = new THREE.InstancedMesh(cellGeo, new THREE.MeshBasicMaterial({ color: 0xffffff }), 512);
      const m4 = new THREE.Matrix4();
      const shade = new THREE.Color();
      for (let i = 0; i < 512; i++) {
        const [x, z] = cellXZ(i);
        m4.makeTranslation(x, 0.1, z);
        inst.setMatrixAt(i, m4);
        shade.setHex(CELL).multiplyScalar(0.55 + ((i * 37) % 13) / 42);
        inst.setColorAt(i, shade);
      }
      inst.instanceMatrix.needsUpdate = true;
      g.add(inst);
      scene.add(g);
      return { ...L, group: g };
    });

    // ── cr3 chip ─────────────────────────────────────────────────
    const cr3 = new THREE.Mesh(
      new THREE.BoxGeometry(1.5, 0.38, 0.9),
      new THREE.MeshBasicMaterial({ color: AMBER })
    );
    cr3.position.set(-5.4, LEVELS[0].y + 2.1, 0);
    scene.add(cr3);

    // ── highlight + glow ─────────────────────────────────────────
    const hi = new THREE.Mesh(
      new THREE.BoxGeometry(0.34, 0.16, 0.34),
      new THREE.MeshBasicMaterial({ color: SKY })
    );
    const glowTex = (() => {
      const c = document.createElement('canvas'); c.width = c.height = 64;
      const g = c.getContext('2d')!;
      const r = g.createRadialGradient(32, 32, 2, 32, 32, 30);
      r.addColorStop(0, 'rgba(255,255,255,0.9)');
      r.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = r; g.fillRect(0, 0, 64, 64);
      const t = new THREE.CanvasTexture(c);
      t.colorSpace = THREE.SRGBColorSpace;
      return t;
    })();
    const hiGlow = new THREE.Sprite(new THREE.SpriteMaterial({
      map: glowTex, color: SKY, transparent: true, opacity: 0.8,
      blending: THREE.AdditiveBlending, depthWrite: false,
    }));
    hiGlow.scale.set(1.6, 1.6, 1);
    scene.add(hi, hiGlow);
    const cr3Glow = new THREE.Sprite(new THREE.SpriteMaterial({
      map: glowTex, color: AMBER, transparent: true, opacity: 0.7,
      blending: THREE.AdditiveBlending, depthWrite: false,
    }));
    cr3Glow.scale.set(2.4, 2.4, 1);
    cr3Glow.position.copy(cr3.position);
    scene.add(cr3Glow);

    // ── beam + spark ─────────────────────────────────────────────
    const beamMat = new THREE.LineBasicMaterial({
      color: SKY, transparent: true, opacity: 0, blending: THREE.AdditiveBlending,
    });
    const beamGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3(), new THREE.Vector3()]);
    const beam = new THREE.Line(beamGeo, beamMat);
    const spark = new THREE.Sprite(new THREE.SpriteMaterial({
      map: glowTex, color: SKY, transparent: true, opacity: 0,
      blending: THREE.AdditiveBlending, depthWrite: false,
    }));
    spark.scale.set(0.9, 0.9, 1);
    scene.add(beam, spark);

    // ── physical page lattice ────────────────────────────────────
    const PN = 128;
    const pPos = new Float32Array(PN * 3);
    const pSeed = new Float32Array(PN);
    for (let i = 0; i < PN; i++) {
      const c = i % 32, r = Math.floor(i / 32);
      pPos[i * 3] = (c - 15.5) * 0.34;
      pPos[i * 3 + 1] = PHYS_Y + 0.15 + (r % 4) * 0.14;
      pPos[i * 3 + 2] = (Math.floor(i / 32) - 1.5) * 0.6;
      pSeed[i] = Math.random();
    }
    const pGeo = new THREE.BufferGeometry();
    pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
    pGeo.setAttribute('aSeed', new THREE.BufferAttribute(pSeed, 1));
    const physMat = new THREE.ShaderMaterial({
      uniforms: { uTime: { value: 0 }, uWave: { value: 0 } },
      transparent: true, depthWrite: false,
      vertexShader: /* glsl */ `
        attribute float aSeed;
        uniform float uTime;
        uniform float uWave;
        varying float vA;
        void main() {
          float d = length(position.xz) / 5.4;
          vA = smoothstep(d, d - 0.18, uWave) * (0.55 + 0.45 * sin(uTime * 3.0 + aSeed * 40.0));
          vec4 mv = modelViewMatrix * vec4(position, 1.0);
          gl_PointSize = 46.0 / -mv.z;
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: /* glsl */ `
        varying float vA;
        void main() {
          float d = length(gl_PointCoord - 0.5);
          float a = smoothstep(0.5, 0.1, d) * vA;
          if (a < 0.01) discard;
          gl_FragColor = vec4(0.62, 0.81, 0.42, a);
        }
      `,
    });
    const phys = new THREE.Points(pGeo, physMat);
    scene.add(phys);

    // ── ui refs ──────────────────────────────────────────────────
    const elVa = document.getElementById('pw-va')!;
    const elPath = document.getElementById('pw-path')!;
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

    // ── camera + lifecycle ───────────────────────────────────────
    let mx = 0, my = 0;
    window.addEventListener('pointermove', (e) => {
      mx = (e.clientX / window.innerWidth) * 2 - 1;
      my = (e.clientY / window.innerHeight) * 2 - 1;
    }, { passive: true });
    const resize = () => {
      renderer.setSize(canvas.parentElement!.clientWidth, canvas.parentElement!.clientHeight, false);
      camera.aspect = canvas.parentElement!.clientWidth / canvas.parentElement!.clientHeight;
      camera.updateProjectionMatrix();
    };
    resize();
    window.addEventListener('resize', resize);

    let bandVisible = true;
    new IntersectionObserver(([e]) => { bandVisible = e.isIntersecting; }).observe(canvas);

    // ── walk plan: a flat, declarative timeline per address ──────
    const V3 = THREE.Vector3;
    const targetPos = (levelIdx: number, cellIdx: number) => {
      const [x, z] = cellXZ(cellIdx);
      return new V3(x, levelObjs[levelIdx].y + 0.2, z);
    };

    interface Action { t: number; run: (ctx: WalkCtx) => void }
    interface WalkCtx { va: number; miss?: number; indices: number[] }

    function buildWalk(walk: { va: number; miss?: number }): { actions: Action[]; end: number } {
      const indices = LEVELS.map((L) => idxOf(walk.va, L.shift));
      const actions: Action[] = [];
      let t = 500;
      actions.push({ t: 0, run: (c) => {
        elVa.textContent = hex(c.va);
        elPath.innerHTML = 'cr3 &rarr;';
        physMat.uniforms.uWave.value = 0;
      }});
      for (let i = 0; i < 4; i++) {
        const levelIdx = i;
        actions.push({ t, run: (c) => {
          const from = levelIdx === 0 ? cr3.position.clone() : targetPos(levelIdx - 1, c.indices[levelIdx - 1]);
          const to = targetPos(levelIdx, c.indices[levelIdx]);
          const mid = from.clone().lerp(to, 0.5);
          mid.y += 0.9;
          beamGeo.setFromPoints([from, mid, to]);
          beamMat.opacity = 0.55;
          beamMat.color.setHex(SKY);
          beamAnim = { from, mid, to, start: t, dur: 620 };
        }});
        t += 620;
        const isMiss = walk.miss !== undefined && walk.miss === levelIdx;
        actions.push({ t, run: (c) => {
          const [x, z] = cellXZ(c.indices[levelIdx]);
          hi.position.set(x, levelObjs[levelIdx].y + 0.2, z);
          hiGlow.position.copy(hi.position);
          if (isMiss) {
            hi.material.color.setHex(CRIT);
            hiGlow.material.color.setHex(CRIT);
            beamMat.color.setHex(CRIT);
            elPath.innerHTML += ` &rarr; <span class="miss">${esc(LEVELS[levelIdx].name)}[${c.indices[levelIdx]}] not present</span>`;
          } else {
            hi.material.color.setHex(SKY);
            hiGlow.material.color.setHex(SKY);
            elPath.innerHTML += (levelIdx === 0 ? '' : ' &rarr; ') + esc(`${LEVELS[levelIdx].name}[${c.indices[levelIdx]}]`);
          }
        }});
        t += isMiss ? 500 : 230;
        if (isMiss) {
          t += 500;
          actions.push({ t, run: () => {
            elPath.innerHTML += ' <span class="miss">&rarr; #PF</span>';
          }});
          t += 1600;
          return { actions, end: t };
        }
      }
      // pt -> physical frame
      actions.push({ t, run: (c) => {
        const from = targetPos(3, c.indices[3]);
        const to = new V3(0, PHYS_Y + 0.4, 0);
        const mid = from.clone().lerp(to, 0.5);
        mid.y += 0.8;
        beamGeo.setFromPoints([from, mid, to]);
        beamMat.opacity = 0.55;
        beamMat.color.setHex(SKY);
        beamAnim = { from, mid, to, start: t, dur: 700 };
      }});
      t += 700;
      const physAddr = (c2n(indices) & 0xffffffffff) * 4096 + (walk.va % 4096);
      actions.push({ t, run: (c) => {
        physMat.uniforms.uWave.value = 0.001;
        waveStart = t;
        hi.material.color.setHex(GREEN);
        hiGlow.material.color.setHex(GREEN);
        elPath.innerHTML += ` &rarr; <span class="phys">page @ ${hex(physAddr)}</span>`;
      }});
      t += 2600;
      return { actions, end: t };

      function c2n(idx: number[]): number {
        // scramble the table indices into a plausible physical base
        let v = 0x1234;
        for (const x of idx) v = (v * 31 + x) % 0xffffffffff;
        return v;
      }
    }

    let beamAnim: { from: V3; mid: V3; to: V3; start: number; dur: number } | null = null;
    let waveStart = -1;

    // ── loop ─────────────────────────────────────────────────────
    let wi = 0;
    let plan = buildWalk(WALKS[0]);
    let walkStart = performance.now() + 800;
    let ai = 0;
    let last = performance.now();

    function tick(now: number) {
      if (now >= walkStart) {
        const t = now - walkStart;
        while (ai < plan.actions.length && plan.actions[ai].t <= t) {
          plan.actions[ai].run({ va: WALKS[wi].va, miss: WALKS[wi].miss, indices: LEVELS.map((L) => idxOf(WALKS[wi].va, L.shift)) });
          ai++;
        }
        if (beamAnim) {
          const p = Math.min((t - beamAnim.start) / beamAnim.dur, 1);
          const q = p * p * (3 - 2 * p);
          spark.position
            .addScaledVector(beamAnim.from, (1 - q) * (1 - q))
            .addScaledVector(beamAnim.mid, 2 * (1 - q) * q)
            .addScaledVector(beamAnim.to, q * q);
          spark.material.opacity = 0.95 * (1 - p * 0.25);
          if (p >= 1) { beamAnim = null; beamMat.opacity = 0; spark.material.opacity = 0; }
        }
        if (waveStart >= 0) {
          physMat.uniforms.uWave.value = Math.min((t - waveStart) / 1400, 1.2);
        }
        if (ai >= plan.actions.length && t >= plan.end) {
          wi = (wi + 1) % WALKS.length;
          plan = buildWalk(WALKS[wi]);
          walkStart = now + 400;
          ai = 0;
          beamAnim = null;
          waveStart = -1;
        }
      }

      const pulse = 1 + Math.sin(now / 180) * 0.08;
      hi.scale.setScalar(pulse);
      hiGlow.scale.setScalar(1.6 * pulse);
      physMat.uniforms.uTime.value = now / 1000;

      const az = 0.42 * Math.sin(now / 9000) + mx * 0.22;
      camera.position.set(Math.sin(az) * 12.8 + 1.4, 5.4 - my * 0.8, Math.cos(az) * 12.8);
      camera.lookAt(1.4, -1.2, 0);
      renderer.render(scene, camera);
      if (bandVisible && !document.hidden) requestAnimationFrame(tick);
    }

    if (reduced) {
      const cellIdx = idxOf(WALKS[0].va, LEVELS[2].shift);
      const [x, z] = cellXZ(cellIdx);
      hi.position.set(x, levelObjs[2].y + 0.2, z);
      hiGlow.position.copy(hi.position);
      elVa.textContent = hex(WALKS[0].va);
      elPath.innerHTML = 'cr3 &rarr; pml4[1] &rarr; pdpt[1] &rarr; <span class="miss">pd[233]</span>';
      camera.position.set(4.6, 5.6, 12.4);
      camera.lookAt(1.4, -1.2, 0);
      renderer.render(scene, camera);
      return;
    }

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) { last = performance.now(); requestAnimationFrame(tick); }
    });
    requestAnimationFrame(tick);
  };

  const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 300));
  idle(() => { void boot(); });
</script>
